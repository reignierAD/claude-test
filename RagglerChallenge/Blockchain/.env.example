# Copy to .env and fill in real values. NEVER commit .env to git.

# Wallet that deploys and owns the contracts
DEPLOYER_PRIVATE_KEY=0xYOUR_DEPLOYER_KEY_HERE

# Separate key used only to sign game results (keep on signer server)
GAME_SIGNER_PRIVATE_KEY=0xYOUR_SIGNER_KEY_HERE

# Get from https://testnet.bscscan.com/myapikey (optional, for contract verification)
BSCSCAN_API_KEY=

# tBNB faucet: https://testnet.binance.org/faucet-smart
# Both keys need testnet BNB for gas (deployer for deployment, signer server runs serverside)
