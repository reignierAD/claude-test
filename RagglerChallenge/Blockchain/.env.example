# Copy to signer-server/.env — NEVER commit .env to git.

# ── Wallet keys ────────────────────────────────────────────────────────────────
# Wallet that deploys and owns the contracts
DEPLOYER_PRIVATE_KEY=0xYOUR_DEPLOYER_KEY_HERE

# Separate hot-wallet used ONLY to sign game results (stays on this server)
GAME_SIGNER_PRIVATE_KEY=0xYOUR_SIGNER_KEY_HERE

# ── Moralis ────────────────────────────────────────────────────────────────────
# Get free API key at https://admin.moralis.com
MORALIS_API_KEY=YOUR_MORALIS_API_KEY_HERE

# Set after running setupMoralisStream.js
MORALIS_STREAM_ID=

# Deployed contract addresses (filled by deploy.js automatically)
RAGG_TOKEN_ADDRESS=
GAME_REWARDS_ADDRESS=

# ── Auth ───────────────────────────────────────────────────────────────────────
# Random secret for JWT signing — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_RANDOM_32_BYTES
JWT_EXPIRES=2h

# Domain shown in Moralis Auth EIP-4361 message
AUTH_DOMAIN=raggler.game
AUTH_URI=https://raggler.game

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3001
ALLOWED_ORIGIN=*

# Public URL of this server (used by Moralis Streams webhook + Unity WS)
WEBHOOK_URL=https://your-server.example.com/streams/webhook
BACKEND_URL=https://your-server.example.com
WS_URL=wss://your-server.example.com/ws

# ── BscScan (optional, for contract verification) ──────────────────────────────
BSCSCAN_API_KEY=

# tBNB faucet: https://testnet.binance.org/faucet-smart
